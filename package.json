{
  "name": "vessel-control",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vessel Control — gestión de clientes, descarga de buques, básculas, productividad y reportes",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --dir tests/unit",
    "test:e2e": "vitest run --dir tests/e2e --no-file-parallelism",
    "db:reset": "supabase db reset",
    "edge:local": "node scripts/vendor-edge-deps.mjs on && supabase functions serve --env-file supabase/functions/.env.local",
    "edge:prod-deps": "node scripts/vendor-edge-deps.mjs off"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "supabase": "^2.122.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
