# Variables de las Edge Functions (además de SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY, que Supabase inyecta).
PUBLIC_VERIFY_URL=http://127.0.0.1:5173/verificar
PUBLIC_APP_URL=http://127.0.0.1:5173
# Orígenes permitidos para CORS (separados por coma). En producción, el dominio de Vercel.
ALLOWED_ORIGINS=*
# Correo opcional para notificar a clientes (Resend). Sin clave, solo hay notificación en el portal.
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL=reportes@su-dominio.com
